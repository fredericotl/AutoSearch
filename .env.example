# No quotes, no spaces around `=`, no `$` in values. Gmail app password without the spaces Google displays.

# Database
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/autosearch
SQLALCHEMY_DATABASE_URL_DOCKER=postgresql+psycopg://postgres:your-password@host.docker.internal:5432/autosearch

# Auth
SECRET_KEY=change-me

# Email — Gmail app password, exactly 16 characters
SENDER_EMAIL=your@email.com
SENDER_PASSWORD=xxxxxxxxxxxxxxxx

LOG_LEVEL=INFO

TIME_ZONE=America/Sao_Paulo
